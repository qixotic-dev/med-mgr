{
  "name": "rx-order-manager",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/rx-order-manager/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/rx-order-manager",
        "browser": "apps/rx-order-manager/src/main.ts",
        "tsConfig": "apps/rx-order-manager/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/rx-order-manager/public"
          }
        ],
        "styles": ["apps/rx-order-manager/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "800kb",
              "maximumError": "1.2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/rx-order-manager/src/environments/environment.ts",
              "with": "apps/rx-order-manager/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "rx-order-manager:build:production"
        },
        "development": {
          "buildTarget": "rx-order-manager:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "rx-order-manager:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/rx-order-manager/jest.config.cts",
        "tsConfig": "apps/rx-order-manager/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "rx-order-manager:build",
        "port": 4200,
        "staticFilePath": "dist/apps/rx-order-manager/browser",
        "spa": true
      }
    },
    "deploy-gh-pages": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run deploy:gh-pages"
      }
    },
    "deploy-firebase": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run deploy:firebase"
      }
    }
  }
}
