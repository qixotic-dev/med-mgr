{
  "name": "rx-order-manager",
  "version": "1.0.0",
  "description": "Desktop app for tracking prescription orders and pharmacy management",
  "main": "main.js",
  "homepage": "https://github.com/qixotic-dev/med-manager-desktop",
  "author": "Qixotic",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:win": "electron-builder -w",
    "build:mac": "electron-builder -m",
    "build:linux": "electron-builder -l",
    "pack": "electron-builder --dir",
    "publish": "electron-builder -p always"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.1.4",
    "open": "^11.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}
